# Zenzy Clothing Wear - Environment Configuration
# Copy this file to '.env' and adjust the values to match your local setup.

# Application Server Port
PORT=3000

# MySQL / MariaDB Database Settings
# Standard MySQL/MariaDB port is 3306. If your installation uses 3307, change DB_PORT below.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shop_db
